// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "test current directory",
    "preRunCommands": [
      "type format add --format=binary \"unsigned short\"",
      "type format add --format=binary \"unsigned char\"",
    ],
    "build": {
      "label": "test-mod test",
      "command": "cargo",
      "args": ["test", "--no-run", "--", "test", "--nocapture"],
      "env": {},
      "cwd": "$ZED_DIRNAME",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "tags": [],
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
]
